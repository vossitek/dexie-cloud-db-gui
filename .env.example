# Copy this template to .env and fill in your local configuration.
# Keep client credentials out of VITE_* variables and browser code.
DEXIE_DATABASE_URL=https://your-db.dexie.cloud
DEXIE_CLIENT_ID=
DEXIE_CLIENT_SECRET=
DEXIE_SCHEMA_PATH=./local/schema.json

# Use a schema-only JSON export from the official Dexie Cloud CLI.
# Put it in the gitignored local/ directory; no record export is needed.
# The schema file must contain a top-level "schema" object.
# Use a client allowed to request ACCESS_DB and GLOBAL_READ.
# Local setup validation does not authenticate to the cloud.
# Restart the API after changing this file or the schema export.
# Development (starts Vite and the API together): bun run dev
# Built app: bun run build, then bun run start
# Stop development before starting the built app (both use port 3001).
# Run commands from the repository root; see docs/local-setup.md.
